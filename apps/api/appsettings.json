{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Classifier": {
    "MinimumCacheConfidence": 0.85,
    "MinimumSharedCacheConfidence": 0.90,
    "UseGrpc": true,
    "GrpcAddress": "http://127.0.0.1:50051",
    "DeadlineMilliseconds": 500
  },
  "TarotCache": {
    "CacheVersion": "v3",
    "TaxonomyVersion": "TAXONOMY_V1",
    "PromptVersion": "DEEP_PROMPT_V2",
    "InterpretationVersion": "INTERPRETATION_V1",
    "ModelVersion": "qwen3:8b",
    "AnswerTtlDays": 30
  },
  "DeepSharedCache": {
    "Enabled": true,
    "ReadEnabled": true,
    "WriteEnabled": true,
    "ApprovedIntents": [
      "GENERAL_DAILY",
      "GENERAL_DECISION",
      "GENERAL_DIRECTION",
      "LOVE_GENERAL",
      "LOVE_SINGLE",
      "LOVE_RELATIONSHIP",
      "LOVE_BREAKUP",
      "LOVE_RECONCILIATION",
      "LOVE_NEW_PERSON",
      "LOVE_COMMITMENT",
      "LOVE_DECISION",
      "CAREER_GENERAL",
      "CAREER_NEW_JOB",
      "CAREER_CHANGE_JOB",
      "CAREER_PROMOTION",
      "CAREER_BUSINESS",
      "CAREER_DECISION",
      "CAREER_CONFLICT",
      "MONEY_GENERAL",
      "MONEY_INCOME",
      "MONEY_INVESTMENT",
      "MONEY_BUSINESS",
      "MONEY_DEBT",
      "MONEY_PURCHASE",
      "MONEY_DECISION",
      "FAMILY_GENERAL",
      "FAMILY_CONFLICT",
      "PERSONAL_GROWTH_GENERAL",
      "PERSONAL_GROWTH_HEALING"
    ]
  },
  "StartupCacheWarmup": {
    "Enabled": false,
    "DelaySeconds": 15,
    "RehydrateRedisFromPostgres": true,
    "Locales": [
      "en",
      "th"
    ],
    "ReadingModes": [
      "STANDARD"
    ],
    "ApprovedIntents": [],
    "Spreads": [
      "DAILY_1"
    ],
    "Variants": 1,
    "MaxCombinationsPerStartup": 500,
    "MaxConcurrency": 1,
    "MaxDeepGenerationsPerStartup": 0,
    "RetryCount": 2,
    "RetryDelaySeconds": 10,
    "CanonicalDeepQuestions": {}
  },
  "Redis": {
    "ConnectionString": null
  },
  "Postgres": {
    "ConnectionString": null
  },
  "LLM": {
    "Endpoint": null,
    "Model": "qwen3:8b",
    "MaxConcurrency": 2,
    "TimeoutSeconds": 90,
    "MaxOutputTokens": 5000,
    "RetryCount": 1,
    "DefaultTier": "CORE",
    "EnableCloudFallback": true,
    "AllowCloudForRequestsWithRawQuestion": true,
    "CircuitBreakerFailureThreshold": 2,
    "CircuitBreakerCooldownSeconds": 30,
    "MinimumQualityScore": 0.65,
    "Tiers": [
      {
        "Id": "CORE",
        "Model": "qwen3.8-flash",
        "CacheModelVersion": "qwen3.8-flash-advanced-v1",
        "Workers": [
          {
            "Id": "CORE",
            "Endpoint": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions",
            "Model": "qwen3.8-flash",
            "Provider": "CLOUD_GPU",
            "Priority": 100,
            "MaxConcurrency": 2,
            "ApiKey": "",
            "Enabled": true
          }
        ]
      },
      {
        "Id": "ADVANCED",
        "Model": "qwen3:14b",
        "CacheModelVersion": "qwen3:14b-advanced-v1",
        "Workers": [
          {
            "Id": "advanced-gpu-1",
            "Endpoint": "",
            "Model": "qwen3:14b",
            "Provider": "LOCAL_GPU",
            "Priority": 0,
            "MaxConcurrency": 1,
            "Enabled": false
          }
        ]
      },
      {
        "Id": "PREMIUM",
        "Model": "qwen3:32b",
        "CacheModelVersion": "qwen3:32b-premium-v1",
        "Workers": [
          {
            "Id": "premium-gpu-1",
            "Endpoint": "",
            "Model": "qwen3:32b",
            "Provider": "LOCAL_GPU",
            "Priority": 0,
            "MaxConcurrency": 1,
            "Enabled": false
          },
          {
            "Id": "premium-cloud-1",
            "Endpoint": "",
            "Model": "qwen3:32b",
            "Provider": "CLOUD_GPU",
            "Priority": 100,
            "MaxConcurrency": 2,
            "Enabled": false
          }
        ]
      }
    ],
    "PromptExperiment": {
      "Enabled": true,
      "Id": "reflection-style-v1",
      "Variants": [
        {
          "Id": "CONTROL",
          "Version": "prompt-a-v1",
          "Weight": 1,
          "AdditionalSystemInstruction": ""
        },
        {
          "Id": "ACTION_FOCUSED",
          "Version": "prompt-b-v1",
          "Weight": 1,
          "AdditionalSystemInstruction": "Favor concrete next-step reflection while preserving uncertainty and user agency."
        }
      ]
    }
  },
  "BaseInterpretationCache": {
    "Enabled": true,
    "MaximumEntries": 4096,
    "TtlMinutes": 120
  },
  "ClassifierTraining": {
    "Enabled": true,
    "ConsentVersion": "classifier-training-consent-v1"
  },
  "Admin": {
    "Key": "tarot-dev-admin"
  },
  "DeepReading": {
    "Enabled": true,
    "AllowUnentitledInDevelopment": false,
    "ClaimType": "tarot:deep_reading",
    "ClaimValue": "true",
    "UpgradeUrl": null
  },
  "Cors": {
    "AllowedOrigins": ""
  }
}
