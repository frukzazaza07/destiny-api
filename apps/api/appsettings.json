{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Classifier": {
    "MinimumCacheConfidence": 0.85,
    "UseGrpc": true,
    "GrpcAddress": "http://127.0.0.1:50051",
    "DeadlineMilliseconds": 500
  },
  "TarotCache": {
    "CacheVersion": "v2",
    "PromptVersion": "DEEP_PROMPT_V2",
    "InterpretationVersion": "INTERPRETATION_V1",
    "ModelVersion": "qwen3:8b",
    "AnswerTtlDays": 30
  },
  "Redis": {
    "ConnectionString": null
  },
  "Postgres": {
    "ConnectionString": null
  },
  "LLM": {
    "Endpoint": null,
    "Model": "qwen3:4b",
    "MaxConcurrency": 2,
    "TimeoutSeconds": 90,
    "MaxOutputTokens": 5000,
    "RetryCount": 1,
    "DefaultTier": "CORE",
    "EnableCloudFallback": false,
    "AllowCloudForRequestsWithRawQuestion": false,
    "CircuitBreakerFailureThreshold": 2,
    "CircuitBreakerCooldownSeconds": 30,
    "MinimumQualityScore": 0.65,
    "Tiers": [
      {
        "Id": "CORE",
        "Model": "qwen3:4b",
        "CacheModelVersion": "qwen3:4b-core-v1",
        "Workers": [
          {
            "Id": "core-gpu-1",
            "Endpoint": "",
            "Model": "qwen3:4b",
            "Provider": "LOCAL_GPU",
            "Priority": 0,
            "MaxConcurrency": 2,
            "Enabled": false
          }
        ]
      },
      {
        "Id": "ADVANCED",
        "Model": "qwen3:8b",
        "CacheModelVersion": "qwen3:8b-advanced-v1",
        "Workers": [
          {
            "Id": "advanced-gpu-1",
            "Endpoint": "",
            "Model": "qwen3:8b",
            "Provider": "LOCAL_GPU",
            "Priority": 0,
            "MaxConcurrency": 1,
            "Enabled": false
          }
        ]
      },
      {
        "Id": "PREMIUM",
        "Model": "qwen3:14b",
        "CacheModelVersion": "qwen3:14b-premium-v1",
        "Workers": [
          {
            "Id": "premium-gpu-1",
            "Endpoint": "",
            "Model": "qwen3:14b",
            "Provider": "LOCAL_GPU",
            "Priority": 0,
            "MaxConcurrency": 1,
            "Enabled": false
          },
          {
            "Id": "premium-cloud-1",
            "Endpoint": "",
            "Model": "qwen3:14b",
            "Provider": "CLOUD_GPU",
            "Priority": 100,
            "MaxConcurrency": 2,
            "Enabled": false
          }
        ]
      }
    ],
    "PromptExperiment": {
      "Enabled": true,
      "Id": "reflection-style-v1",
      "Variants": [
        {
          "Id": "CONTROL",
          "Version": "prompt-a-v1",
          "Weight": 1,
          "AdditionalSystemInstruction": ""
        },
        {
          "Id": "ACTION_FOCUSED",
          "Version": "prompt-b-v1",
          "Weight": 1,
          "AdditionalSystemInstruction": "Favor concrete next-step reflection while preserving uncertainty and user agency."
        }
      ]
    }
  },
  "BaseInterpretationCache": {
    "Enabled": true,
    "MaximumEntries": 4096,
    "TtlMinutes": 120
  },
  "ClassifierTraining": {
    "Enabled": true,
    "ConsentVersion": "classifier-training-consent-v1"
  },
  "Admin": {
    "Key": null
  },
  "DeepReading": {
    "Enabled": true,
    "AllowUnentitledInDevelopment": false,
    "ClaimType": "tarot:deep_reading",
    "ClaimValue": "true",
    "UpgradeUrl": null
  },
  "Cors": {
    "AllowedOrigins": ""
  }
}