# Development-only Compose defaults. Copy to .env and change all credentials before deployment.
COMPOSE_PROJECT_NAME=tarot-destiny
ASPNETCORE_ENVIRONMENT=Development

POSTGRES_USER=tarot
POSTGRES_PASSWORD=change-this-development-password
POSTGRES_DB=tarot_destiny
ADMIN_KEY=change-this-admin-key

WEB_PORT=3000
API_PORT=5000
BIND_ADDRESS=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.95:3000
# Browser requests are same-origin through Nginx by default. Set this only when
# running the Next.js development server directly instead of Docker Compose.
NEXT_PUBLIC_API_BASE_URL=

# Local GPU profile: docker compose --profile local-gpu up --build
OLLAMA_MODEL=qwen3:8b
# Add qwen3:14b and qwen3:32b when those tiers are needed and the GPU has capacity.
OLLAMA_MODELS=qwen3:8b
TAROT_LLM_CORE_ENDPOINT=http://ollama:11434/v1/chat/completions
TAROT_LLM_ADVANCED_ENDPOINT=http://ollama:11434/v1/chat/completions
TAROT_LLM_PREMIUM_ENDPOINT=http://ollama:11434/v1/chat/completions

# External GPU profile: set private endpoints, then run with --profile external-gpu.
TAROT_EXTERNAL_LLM_HEALTH_URL=http://host.docker.internal:11434/api/tags
TAROT_LLM_CLOUD_ENDPOINT=https://replace-with-private-cloud-endpoint.invalid/v1/chat/completions
TAROT_LLM_CLOUD_API_KEY=
ENABLE_CLOUD_FALLBACK=false
# Set true to skip LOCAL_GPU workers in the selected tier. Cloud fallback must
# also be enabled, and raw questions require the separate consent switch below.
BYPASS_LOCAL_LLM=false
ALLOW_CLOUD_RAW_QUESTION=false

# Public web metadata and Google monetization. Keep both feature flags false
# until content/legal review, AdSense approval, and regional consent tests pass.
SITE_URL=http://localhost:3000
CONTACT_EMAIL=
ADSENSE_CLIENT_ID=
ADSENSE_GUIDE_SLOT_ID=
ADSENSE_ENABLED=false
GA_MEASUREMENT_ID=
ANALYTICS_ENABLED=false

# Set true only after Cloudflare supplies CF-IPCountry and direct origin access
# is blocked. False classifies every visitor as unknown and loads no Google code.
CF_IPCOUNTRY_TRUSTED=false
