# Development-only Compose defaults. Copy to .env and change all credentials before deployment.
# Start infrastructure first (requires RABBITMQ_PASSWORD):
# docker compose -p tarot-destiny-infra -f docker-compose.infra.yml up -d --wait
# Then start the app with the desired inference profile (see below).
# See INFRASTRUCTURE.md for TLS setup and migration of existing data.
COMPOSE_PROJECT_NAME=tarot-destiny
# Use Production for deployments. API Swagger is enabled in Development;
# the public Nginx configuration blocks Swagger in either environment.
ASPNETCORE_ENVIRONMENT=Development

# Infrastructure creates both edge networks; the app joins APP_EDGE_NETWORK.
# Keep APP_EDGE_NETWORK equal to the chosen infrastructure edge network name.
# Defaults below select the production site's network. For dev.dooduang.cc use
# APP_EDGE_NETWORK=tarot-destiny_dev-edge and NETWORK_EDGE=dev-tarot-destiny
# to match the current Nginx dev upstream aliases. Use a distinct app project
# name for each deployment (the workflows supply it with docker compose -p).
APP_PROD_EDGE_NETWORK=tarot-destiny_prod-edge
APP_DEV_EDGE_NETWORK=tarot-destiny_dev-edge
APP_EDGE_NETWORK=tarot-destiny_prod-edge
NETWORK_EDGE=prod
# Backend name must match between infrastructure and application stacks.
# Preserve existing volume names and broker hostname when migrating data.
APP_BACKEND_NETWORK=tarot-destiny_backend
POSTGRES_VOLUME_NAME=tarot-destiny_postgres-data
REDIS_VOLUME_NAME=tarot-destiny_redis-data
RABBITMQ_VOLUME_NAME=tarot-destiny_rabbitmq_jobs
RABBITMQ_HOSTNAME=rabbitmq

# Private container ports. Keep these defaults unless all dependent service
# URLs and Nginx upstreams are updated too. Database/broker expose settings
# do not change the ports those servers listen on or publish host ports.
API_PORT=5000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672

POSTGRES_USER=tarot
POSTGRES_PASSWORD=change-this-development-password
POSTGRES_DB=tarot_destiny
ADMIN_KEY=change-this-admin-key
# Required even without the jobs overlay. Use a URL-safe password because
# the jobs overlay interpolates it into an AMQP URI without URL encoding.
RABBITMQ_PASSWORD=change-this-development-rabbitmq-password

# User accounts are enabled when PostgreSQL is configured. Public registration
# remains closed until outbound email and abuse controls have been reviewed.
ACCOUNT_PUBLIC_REGISTRATION=false
ACCOUNT_EMAIL_ENABLED=false
ACCOUNT_EMAIL_HOST=
ACCOUNT_EMAIL_PORT=587
ACCOUNT_EMAIL_USE_SSL=true
ACCOUNT_EMAIL_USERNAME=
ACCOUNT_EMAIL_PASSWORD=
ACCOUNT_EMAIL_FROM=

# One-time first administrator bootstrap. Set these only for the bootstrap
# command, then remove them from the runtime environment.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Nginx publishes fixed ports 80/443 and currently requires dooduang.cc TLS
# certificates. Configure the domain/certificates in infra/nginx/nginx.conf.
# Add the deployed site's origin when using cross-origin browser requests.
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000
# Browser requests are same-origin through Nginx by default. Set this only when
# running Next.js directly (for example http://localhost:5000 for a local API).
# Supply it to the web process/build; Compose does not forward this variable,
# and Next.js does not automatically load the repository-root .env.
NEXT_PUBLIC_API_BASE_URL=

# Local GPU profile: docker compose --profile local-gpu up --build
# CORE matches the single model pulled below. Compose otherwise defaults to
# PREMIUM, whose currently configured worker is cloud-only.
LLM_DEFAULT_TIER=CORE
OLLAMA_MODEL=qwen3:8b
# Space-separated models; add qwen3:14b to use ADVANCED.
OLLAMA_MODELS=qwen3:8b
TAROT_LLM_CORE_ENDPOINT=http://ollama:11434/v1/chat/completions
TAROT_LLM_ADVANCED_ENDPOINT=http://ollama:11434/v1/chat/completions
# A local PREMIUM worker is commented out in docker-compose.yml. Enable and
# configure that worker there before adding qwen3:32b to OLLAMA_MODELS.

# External GPU profile: replace the CORE/ADVANCED endpoints above with reachable
# private URLs and set the health URL, then run with --profile external-gpu.
TAROT_EXTERNAL_LLM_HEALTH_URL=http://host.docker.internal:11434/api/tags
# Synchronous cloud inference: configure endpoint/model/key, choose PREMIUM,
# and enable cloud fallback. The model must be supported by your provider.
TAROT_LLM_CLOUD_ENDPOINT=https://replace-with-private-cloud-endpoint.invalid/v1/chat/completions
TAROT_LLM_CLOUD_MODEL=qwen3.8-flash
TAROT_LLM_CLOUD_API_KEY=
ENABLE_CLOUD_FALLBACK=false
# Set true to skip LOCAL_GPU workers in the selected tier. Cloud fallback must
# also be enabled, and raw questions require the separate consent switch below.
BYPASS_LOCAL_LLM=false
ALLOW_CLOUD_RAW_QUESTION=false

# Optional queued DEEP and astrology processing:
# docker compose -f docker-compose.yml -f docker-compose.jobs.yml up -d --build --wait
# Requires the cloud endpoint/model/API key above and a private worker key of
# at least 32 characters below. The provider URL must use HTTPS (HTTP is only
# accepted for localhost/127.0.0.1). Leave the key blank when jobs are unused.
# The overlay enables jobs independently of ENABLE_CLOUD_FALLBACK.
# Astrology and tarot with raw questions require ALLOW_CLOUD_RAW_QUESTION=true.
READING_WORKER_KEY=
CLOUD_MAX_CONCURRENCY=4
CLOUD_REQUESTS_PER_MINUTE=20
CLOUD_TOKENS_PER_MINUTE=200000
# Accepted values: blank, Idempotency-Key, X-Idempotency-Key.
# Choose a header only when the provider supports it.
PROVIDER_IDEMPOTENCY_HEADER=

# Development-only entitlement bypass; keep false to exercise access controls.
DEEP_READING_ALLOW_UNENTITLED_IN_DEVELOPMENT=false

# Public web metadata and Google monetization. Keep both feature flags false
# until content/legal review, AdSense approval, and regional consent tests pass.
# Set SITE_URL to the public HTTPS origin for deployment; also used in emails.
SITE_URL=http://localhost:3000
CONTACT_EMAIL=
ADSENSE_CLIENT_ID=
ADSENSE_GUIDE_SLOT_ID=
ADSENSE_ENABLED=false
GA_MEASUREMENT_ID=
ANALYTICS_ENABLED=false

# Rewarded DEEP remains off until Google Ad Manager eligibility, policy,
# consent, abuse, legal, and cost reviews are complete. This is a public ad-unit
# path, not a secret. The completion threshold and credit grant live in the DB.
REWARDED_DEEP_ENABLED=false
REWARDED_DEEP_AD_UNIT_PATH=

# Set true only after Cloudflare supplies CF-IPCountry and direct origin access
# is blocked. False classifies every visitor as unknown and loads no Google code.
CF_IPCOUNTRY_TRUSTED=false
